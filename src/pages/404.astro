---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  locale="en"
  title="Page Not Found — VastNext"
  description="The requested page could not be found."
  canonicalPath="/404/"
  alternatePath="/404/"
>
  <div style="min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem; font-family: var(--font-display, sans-serif);">
    <h1 style="font-size: 4rem; margin-bottom: 0.5rem; font-weight: 800;">404</h1>
    <p style="font-size: 1.25rem; color: var(--color-ink-soft); margin-bottom: 2rem;">Page not found</p>
    <a href="/" style="display: inline-flex; padding: 0.75rem 1.5rem; background: var(--color-electric); color: #fff; text-decoration: none; border-radius: 999px; font-weight: 700;">Back to Home</a>
  </div>
</BaseLayout>

<script is:inline>
  // Handle SPA fallback for dynamic routes like /2fa/SECRET or /zh/2fa/SECRET
  (function () {
    const path = window.location.pathname;
    const zh2faMatch = path.match(/^\/zh\/2fa\/([^/]+)/);
    const en2faMatch = path.match(/^\/2fa\/([^/]+)/);
    if (zh2faMatch && zh2faMatch[1] !== 'index.html') {
      window.location.replace('/zh/2fa/?secret=' + encodeURIComponent(zh2faMatch[1]));
    } else if (en2faMatch && en2faMatch[1] !== 'index.html') {
      window.location.replace('/2fa/?secret=' + encodeURIComponent(en2faMatch[1]));
    }
  })();
</script>
