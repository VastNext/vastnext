---
import ExternalIcon from './ExternalIcon.astro';
import type { Locale } from '../content/site';
import { openSourceProjects, siteCopy } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale].openSource;
const newWindowLabel = locale === 'zh' ? '（在新窗口打开）' : ' (opens in a new window)';

function isExternalLink(url: string): boolean {
  return /^https?:\/\//.test(url);
}

function projectHref(url: string): string {
  return locale === 'zh' ? `/zh${url}` : url;
}
---

<section id="open-source" class="open-source" aria-labelledby="open-source-title" data-reveal>
  <header class="section-heading open-source__heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="open-source-title">{copy.title}</h2>
    <p>{copy.description}</p>
  </header>

  <div class="open-source__projects">
    {openSourceProjects.map((project) => {
      const projectCopy = copy.projects[project.id];

      return (
        <article
          class={`open-source-project open-source-project--${project.id}`}
          data-project={project.id}
          data-reveal
        >
          <div class="open-source-project__copy">
            <p class="open-source-project__type">{projectCopy.typeLabel}</p>
            <h3>{project.name}</h3>
            <p>{projectCopy.description}</p>
            <ul
              class="open-source-project__facts"
              aria-label={locale === 'zh' ? '项目技术信息' : 'Project facts'}
            >
              {project.facts.map((fact) => <li>{fact}</li>)}
            </ul>
            {isExternalLink(project.url) ? (
              <a href={project.url} target="_blank" rel="noreferrer">
                {projectCopy.cta}
                <ExternalIcon />
                <span class="sr-only">{newWindowLabel}</span>
              </a>
            ) : (
              <a href={projectHref(project.url)}>{projectCopy.cta}</a>
            )}
          </div>

          {project.id === 'glancemd' ? (
            <div class="open-source-project__demo glancemd-demo" aria-hidden="true">
              <div class="glancemd-demo__bar">
                <span>Windows</span><span>macOS</span><span>Linux</span>
              </div>
              <div class="glancemd-demo__workspace">
                <div class="glancemd-demo__editor">
                  <span># Open quickly</span>
                  <span>**Markdown**,</span>
                  <span>at a glance.</span>
                </div>
                <div class="glancemd-demo__preview">
                  <strong>Open quickly</strong>
                  <span>Markdown, at a glance.</span>
                  <i></i><i></i><i></i>
                </div>
              </div>
            </div>
          ) : (
            <div class="open-source-project__demo agent-team-demo" aria-hidden="true">
              <div class="agent-team-demo__modes">
                <span>FAST</span><span>STANDARD</span><span>STRICT</span>
              </div>
              <div class="agent-team-demo__graph">
                <strong>rapid-dev-team</strong>
                <span class="agent-node agent-node--scout">Scout</span>
                <span class="agent-node agent-node--glm">GLM</span>
                <span class="agent-node agent-node--deepseek">DeepSeek</span>
                <span class="agent-node agent-node--reviewer">Reviewer</span>
                <span class="agent-node agent-node--architect">Architect</span>
              </div>
            </div>
          )}
        </article>
      );
    })}
  </div>
</section>
