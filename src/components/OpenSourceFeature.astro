---
import ExternalIcon from './ExternalIcon.astro';
import type { Locale } from '../content/site';
import { openSourceProject, siteCopy } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale].openSource;
const newWindowLabel = locale === 'zh' ? '（在新窗口打开）' : ' (opens in a new window)';
---

<section id="open-source" class="open-source" aria-labelledby="open-source-title">
  <div class="open-source__copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="open-source-title">{openSourceProject.name}</h2>
    <p>{copy.description}</p>
    <ul class="open-source__facts" aria-label={locale === 'zh' ? '项目技术信息' : 'Project facts'}>
      <li>{openSourceProject.platform}</li>
      <li>{openSourceProject.stack}</li>
      <li>{openSourceProject.license}</li>
    </ul>
    <a href={openSourceProject.url} target="_blank" rel="noreferrer">
      {copy.cta}
      <ExternalIcon />
      <span class="sr-only">{newWindowLabel}</span>
    </a>
  </div>
  <div class="open-source__demo" aria-hidden="true">
    <div class="open-source__window-bar"><span></span><span></span><span></span></div>
    <div class="open-source__markdown">
      <span># Open quickly</span>
      <span>Read with focus.</span>
      <span>**Markdown**, at a glance.</span>
    </div>
  </div>
</section>
