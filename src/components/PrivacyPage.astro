---
import BrandMark from './BrandMark.astro';
import type { Locale } from '../content/site';
import { contactFacts, siteCopy } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale];
const privacy = copy.privacy;
const languageHref = locale === 'zh' ? '/privacy/' : '/zh/privacy/';
---

<a class="skip-link" href="#main-content">
  {locale === 'zh' ? '跳到主要内容' : 'Skip to main content'}
</a>
<header class="privacy-header">
  <a class="privacy-header__brand" href={privacy.homeHref} aria-label={locale === 'zh' ? 'VastNext 首页' : 'VastNext home'}>
    <BrandMark />
  </a>
  <a href={languageHref} hreflang={locale === 'zh' ? 'en' : 'zh-CN'}>{copy.languageSwitch.label}</a>
</header>
<main id="main-content" class="privacy-main">
  <article class="privacy-article">
    <header class="privacy-article__header">
      <p class="eyebrow">VastNext</p>
      <h1>{privacy.title}</h1>
      <p class="privacy-article__updated">{privacy.updatedLabel}: {privacy.updatedDate}</p>
      <p class="privacy-article__introduction">{privacy.introduction}</p>
    </header>
    <section>
      <h2>{privacy.sections[0]}</h2>
      <p>{privacy.noCollection}</p>
    </section>
    <section>
      <h2>{privacy.sections[1]}</h2>
      <p>{privacy.technicalData}</p>
    </section>
    <section>
      <h2>{privacy.sections[2]}</h2>
      <p>{privacy.externalLinks}</p>
    </section>
    <section>
      <h2>{privacy.contactTitle}</h2>
      <p>{privacy.contact} <a href={`mailto:${contactFacts.email}`}>{contactFacts.email}</a>.</p>
    </section>
    <a class="privacy-article__home" href={privacy.homeHref}>{privacy.homeLabel}</a>
  </article>
</main>
