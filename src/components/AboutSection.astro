---
import type { Locale } from '../content/site';
import { siteCopy } from '../content/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale].about;
---

<section id="about" class="about" aria-labelledby="about-title" data-reveal>
  <p class="eyebrow">{copy.eyebrow}</p>
  <h2 id="about-title">{copy.title}</h2>
  <p>{copy.description}</p>
  <div class="about__equation" data-brand-equation aria-hidden="true">
    <span>Vast</span><span> + </span><span>Next</span>
    <strong>{locale === 'zh' ? '瀚海·未来' : 'Vast horizons · What comes next'}</strong>
  </div>
  <p class="sr-only">{copy.equationLabel}</p>
</section>
