---
import '../styles/two-factor.css';
import type { Locale } from '../content/site';
import { twoFactorCopy } from '../content/twoFactor';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = twoFactorCopy[locale];
const homeHref = locale === 'zh' ? '/zh/' : '/';
const langSwitchHref = locale === 'zh' ? '/2fa/' : '/zh/2fa/';
const langSwitchLabel = locale === 'zh' ? 'English' : '中文';
---

<div class="tf-page" data-locale={locale}>
  <header class="tf-header">
    <div class="tf-container tf-header__inner">
      <a href={homeHref} class="tf-header__brand">
        <span style="font-weight: 800; font-size: 1.2rem; letter-spacing: -0.02em;">VastNext</span>
        <span class="tf-header__badge">2FA</span>
      </a>
      <nav class="tf-header__nav">
        <a href={homeHref}>{copy.backHome}</a>
        <a href={langSwitchHref}>{langSwitchLabel}</a>
      </nav>
    </div>
  </header>

  <main class="tf-container">
    <!-- Hero Section -->
    <section class="tf-hero">
      <div class="tf-hero__badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>{copy.hero.badge}</span>
      </div>
      <h1 class="tf-hero__title">{copy.hero.title}</h1>
      <p class="tf-hero__subtitle">{copy.hero.subtitle}</p>
    </section>

    <!-- Error Alert Box -->
    <div id="tf-error" class="tf-error-box" role="alert"></div>

    <!-- Active 2FA Card (Visible when secret is loaded) -->
    <section id="tf-active-card" class="tf-card tf-card--interactive" title={copy.directView.clickToCopy}>
      <div class="tf-card__header">
        <div class="tf-card__meta">
          <span id="tf-card-issuer" class="tf-card__issuer">2FA Account</span>
          <span id="tf-card-account" class="tf-card__account" style="display: none;"></span>
        </div>
        <div id="tf-status-pill" class="tf-status-pill tf-status-pill--active">
          <span class="tf-status-dot"></span>
          <span id="tf-status-text">{copy.directView.sessionTitle}</span>
        </div>
      </div>

      <div id="tf-code-box" class="tf-code-display">
        <div class="tf-code-digits" id="tf-code-text">------</div>
        <div id="tf-copy-hint" class="tf-copy-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="tf-copy-hint-text">{copy.directView.clickToCopy}</span>
        </div>
      </div>

      <div class="tf-timers">
        <!-- 30s Period Dial Meter -->
        <div class="tf-period-meter">
          <svg class="tf-dial-svg" viewBox="0 0 44 44">
            <circle class="tf-dial-bg" cx="22" cy="22" r="18"></circle>
            <circle id="tf-dial-progress" class="tf-dial-progress" cx="22" cy="22" r="18" stroke-dasharray="113.1" stroke-dashoffset="0"></circle>
          </svg>
          <div class="tf-period-info">
            <span id="tf-period-seconds" class="tf-period-count">30s</span>
            <span class="tf-period-label">{copy.directView.periodRemaining}</span>
          </div>
        </div>

        <!-- 3-Minute Session Countdown -->
        <div class="tf-session-meter">
          <span class="tf-session-label">{copy.directView.sessionTimeRemaining}</span>
          <span id="tf-session-countdown" class="tf-session-time">03:00</span>
        </div>
      </div>

      <!-- 3-Minute Expired Banner -->
      <div id="tf-expired-banner" class="tf-expired-banner" style="display: none;">
        <div class="tf-expired-text">
          <div class="tf-expired-title">{copy.directView.sessionExpiredTitle}</div>
          <p class="tf-expired-desc">{copy.directView.sessionExpiredDesc}</p>
        </div>
        <button id="tf-btn-resume" type="button" class="tf-btn-resume">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          {copy.directView.sessionExpiredAction}
        </button>
      </div>
    </section>

    <!-- Manual Input & Secret Management Section -->
    <section class="tf-input-section">
      <h2 class="tf-input-section__title">{copy.manualInput.title}</h2>
      <p class="tf-input-section__desc">{copy.manualInput.description}</p>

      <textarea
        id="tf-secret-input"
        class="tf-textarea"
        placeholder={copy.manualInput.inputPlaceholder}
        rows="2"
      ></textarea>

      <div class="tf-actions">
        <button id="tf-btn-calculate" type="button" class="tf-btn-primary">
          {copy.manualInput.calculateBtn}
        </button>
        <button id="tf-btn-test-key" type="button" class="tf-btn-secondary">
          {copy.manualInput.insertTestKeyBtn}
        </button>
        <button id="tf-btn-clear" type="button" class="tf-btn-secondary">
          {copy.manualInput.clearBtn}
        </button>
      </div>

      <!-- Shareable Direct Link Box -->
      <div id="tf-share-box" class="tf-share-box" style="display: none;">
        <div class="tf-share-title">{copy.manualInput.shareLinkTitle}</div>
        <div class="tf-share-desc">{copy.manualInput.shareLinkDesc}</div>
        <div class="tf-share-input-group">
          <input id="tf-share-url-input" class="tf-share-input" type="text" readonly />
          <button id="tf-btn-copy-share" type="button" class="tf-btn-primary" style="padding: 0.6rem 1rem; font-size: 0.85rem;">
            {copy.manualInput.shareLinkCopyBtn}
          </button>
        </div>
      </div>
    </section>

    <!-- Trust & Security Info Section -->
    <section class="tf-security-section">
      <h2 class="tf-security-title">{copy.security.title}</h2>
      <div class="tf-security-grid">
        {copy.security.items.map((item) => (
          <div class="tf-security-card">
            <h3 class="tf-security-card__title">{item.title}</h3>
            <p class="tf-security-card__desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- Toast Notification -->
  <div id="tf-toast" class="tf-toast">{copy.directView.copied}</div>
</div>

<script>
  import { Base32Error } from '../lib/twoFactor/base32';
  import { generateTotp, secondsUntilNextCode, periodProgress } from '../lib/twoFactor/totp';
  import { parseInputToAccount, formatOtpCode, OtpauthUriError, type Account } from '../lib/twoFactor/otpauth';
  import { OtpError } from '../lib/twoFactor/hotp';

  const RFC_TEST_KEY = 'GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ';
  const THREE_MINUTES_MS = 3 * 60 * 1000;
  const CIRCLE_CIRCUMFERENCE = 113.1; // 2 * PI * 18

  let currentAccount: Account | null = null;
  let sessionStartTime = 0;
  let isExpired = false;
  let refreshTimer: number | null = null;

  // DOM Elements
  const errorEl = document.getElementById('tf-error');
  const activeCardEl = document.getElementById('tf-active-card');
  const cardIssuerEl = document.getElementById('tf-card-issuer');
  const cardAccountEl = document.getElementById('tf-card-account');
  const statusPillEl = document.getElementById('tf-status-pill');
  const statusTextEl = document.getElementById('tf-status-text');
  const codeBoxEl = document.getElementById('tf-code-box');
  const codeTextEl = document.getElementById('tf-code-text');
  const copyHintEl = document.getElementById('tf-copy-hint');
  const copyHintTextEl = document.getElementById('tf-copy-hint-text');
  const dialProgressEl = document.getElementById('tf-dial-progress');
  const periodSecondsEl = document.getElementById('tf-period-seconds');
  const sessionCountdownEl = document.getElementById('tf-session-countdown');
  const expiredBannerEl = document.getElementById('tf-expired-banner');
  const btnResumeEl = document.getElementById('tf-btn-resume');

  const secretInputEl = document.getElementById('tf-secret-input') as HTMLTextAreaElement;
  const btnCalculateEl = document.getElementById('tf-btn-calculate');
  const btnTestKeyEl = document.getElementById('tf-btn-test-key');
  const btnClearEl = document.getElementById('tf-btn-clear');
  const shareBoxEl = document.getElementById('tf-share-box');
  const shareUrlInputEl = document.getElementById('tf-share-url-input') as HTMLInputElement;
  const btnCopyShareEl = document.getElementById('tf-btn-copy-share');
  const toastEl = document.getElementById('tf-toast');

  const pageContainer = document.querySelector('.tf-page');
  const isZh = pageContainer?.getAttribute('data-locale') === 'zh';

  function showError(msg: string): void {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
  }

  function clearError(): void {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function showToast(text: string): void {
    if (!toastEl) return;
    toastEl.textContent = text;
    toastEl.classList.add('tf-toast--visible');
    setTimeout(() => {
      toastEl.classList.remove('tf-toast--visible');
    }, 2000);
  }

  function formatTime(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  // Extract secret from URL pathname or searchParams or hash
  function extractSecretFromLocation(): string | null {
    const searchParams = new URLSearchParams(window.location.search);
    const querySecret = searchParams.get('secret') || searchParams.get('key');
    if (querySecret) return querySecret.trim();

    if (window.location.hash) {
      const hash = window.location.hash.slice(1).trim();
      if (hash) return hash;
    }

    const pathname = window.location.pathname;
    // Matching /2fa/SECRET or /zh/2fa/SECRET
    const match = pathname.match(/(?:\/zh)?\/2fa\/([^/]+)/);
    if (match && match[1] && match[1] !== 'index.html') {
      try {
        return decodeURIComponent(match[1]).trim();
      } catch {
        return match[1].trim();
      }
    }

    return null;
  }

  function updateShareUrl(rawSecret: string): void {
    if (!shareBoxEl || !shareUrlInputEl) return;
    const origin = window.location.origin;
    const prefix = isZh ? '/zh/2fa/' : '/2fa/';
    const fullUrl = `${origin}${prefix}${rawSecret}`;
    shareUrlInputEl.value = fullUrl;
    shareBoxEl.style.display = 'block';
  }

  async function updateTotpDisplay(): Promise<void> {
    if (!currentAccount) return;

    const nowMs = Date.now();
    const elapsedSession = nowMs - sessionStartTime;
    const remainingSessionMs = Math.max(0, THREE_MINUTES_MS - elapsedSession);
    const remainingSessionSec = Math.ceil(remainingSessionMs / 1000);

    // Update 3-minute session countdown
    if (sessionCountdownEl) {
      sessionCountdownEl.textContent = formatTime(remainingSessionSec);
    }

    // Check 3-minute expiration
    if (remainingSessionMs <= 0 && !isExpired) {
      isExpired = true;
      if (statusPillEl) {
        statusPillEl.className = 'tf-status-pill tf-status-pill--expired';
      }
      if (statusTextEl) {
        statusTextEl.textContent = isZh ? '已停止自动刷新（3分钟上限）' : 'Auto-refresh stopped';
      }
      if (codeBoxEl) {
        codeBoxEl.classList.add('tf-code-display--expired');
      }
      if (expiredBannerEl) {
        expiredBannerEl.style.display = 'flex';
      }
      return;
    }

    if (isExpired) return;

    const nowSec = nowMs / 1000;
    const period = currentAccount.period;
    const secondsLeft = secondsUntilNextCode(nowSec, period);
    const progress = periodProgress(nowSec, period);

    // Update Dial
    if (periodSecondsEl) {
      periodSecondsEl.textContent = `${secondsLeft}s`;
    }
    if (dialProgressEl) {
      const offset = CIRCLE_CIRCUMFERENCE * (1 - progress);
      dialProgressEl.style.strokeDashoffset = String(offset);
      if (secondsLeft <= 5) {
        dialProgressEl.classList.add('tf-dial-progress--urgent');
      } else {
        dialProgressEl.classList.remove('tf-dial-progress--urgent');
      }
    }

    // Compute TOTP Code
    try {
      const rawCode = await generateTotp({
        secret: currentAccount.secret,
        unixSeconds: nowSec,
        algorithm: currentAccount.algorithm,
        digits: currentAccount.digits,
        period: currentAccount.period,
      });

      if (codeTextEl) {
        codeTextEl.textContent = formatOtpCode(rawCode);
      }
    } catch (err) {
      console.error('Error generating TOTP:', err);
    }
  }

  function startSessionForAccount(account: Account): void {
    currentAccount = account;
    sessionStartTime = Date.now();
    isExpired = false;

    clearError();

    if (cardIssuerEl) {
      cardIssuerEl.textContent = account.issuer || (isZh ? '2FA 验证码' : '2FA Code');
    }
    if (cardAccountEl) {
      if (account.accountName) {
        cardAccountEl.textContent = account.accountName;
        cardAccountEl.style.display = 'inline-block';
      } else {
        cardAccountEl.style.display = 'none';
      }
    }

    if (statusPillEl) {
      statusPillEl.className = 'tf-status-pill tf-status-pill--active';
    }
    if (statusTextEl) {
      statusTextEl.textContent = isZh ? '实时刷新中' : 'Auto-refresh Active';
    }
    if (codeBoxEl) {
      codeBoxEl.classList.remove('tf-code-display--expired');
    }
    if (expiredBannerEl) {
      expiredBannerEl.style.display = 'none';
    }

    updateShareUrl(account.rawSecret);

    if (refreshTimer) {
      clearInterval(refreshTimer);
    }

    updateTotpDisplay();
    refreshTimer = window.setInterval(updateTotpDisplay, 500);
  }

  function loadFromText(text: string): boolean {
    try {
      const account = parseInputToAccount(text);
      startSessionForAccount(account);
      return true;
    } catch (error) {
      if (error instanceof Base32Error || error instanceof OtpauthUriError || error instanceof OtpError) {
        showError(error.message);
      } else if (error instanceof Error) {
        showError(error.message);
      } else {
        showError(isZh ? '无法解析该密钥，请检查格式。' : 'Unable to parse secret. Please check format.');
      }
      return false;
    }
  }

  // Copy code to clipboard
  async function copyCurrentCode(): Promise<void> {
    if (!codeTextEl) return;
    const textToCopy = codeTextEl.textContent?.replace(/\s+/g, '') || '';
    if (!textToCopy || textToCopy === '------') return;

    try {
      await navigator.clipboard.writeText(textToCopy);
      showToast(isZh ? `已复制验证码: ${textToCopy}` : `Copied code: ${textToCopy}`);
      if (copyHintEl && copyHintTextEl) {
        copyHintEl.classList.add('tf-copy-hint--copied');
        copyHintTextEl.textContent = isZh ? '已复制！' : 'Copied!';
        setTimeout(() => {
          copyHintEl.classList.remove('tf-copy-hint--copied');
          copyHintTextEl.textContent = isZh ? '点击验证码一键复制' : 'Click code to copy';
        }, 2000);
      }
    } catch {
      showToast(isZh ? '复制失败，请手动选择复制' : 'Copy failed, please select manually');
    }
  }

  // Event Listeners
  activeCardEl?.addEventListener('click', (e) => {
    // Avoid triggering copy when clicking the resume button
    if (e.target instanceof Element && e.target.closest('#tf-btn-resume')) return;
    copyCurrentCode();
  });

  btnResumeEl?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentAccount) {
      startSessionForAccount(currentAccount);
      showToast(isZh ? '已重新启动 3 分钟自动刷新' : '3-Minute auto-refresh resumed');
    }
  });

  btnCalculateEl?.addEventListener('click', () => {
    const val = secretInputEl?.value?.trim();
    if (!val) {
      showError(isZh ? '请输入密钥或 otpauth 链接。' : 'Please enter a secret or otpauth link.');
      return;
    }
    loadFromText(val);
  });

  btnTestKeyEl?.addEventListener('click', () => {
    if (secretInputEl) {
      secretInputEl.value = RFC_TEST_KEY;
    }
    loadFromText(RFC_TEST_KEY);
    showToast(isZh ? '已加载官方 RFC 测试密钥' : 'RFC test key loaded');
  });

  btnClearEl?.addEventListener('click', () => {
    if (secretInputEl) secretInputEl.value = '';
    clearError();
  });

  btnCopyShareEl?.addEventListener('click', async () => {
    if (!shareUrlInputEl) return;
    try {
      await navigator.clipboard.writeText(shareUrlInputEl.value);
      showToast(isZh ? '快捷访问链接已复制！' : 'Shareable link copied!');
    } catch {
      showToast(isZh ? '复制失败，请手动复制' : 'Copy failed, please copy manually');
    }
  });

  // On page load: check if secret exists in URL
  const initialSecret = extractSecretFromLocation();
  if (initialSecret) {
    if (secretInputEl) secretInputEl.value = initialSecret;
    loadFromText(initialSecret);
  } else {
    // Default load test key for demo or leave ready
    loadFromText(RFC_TEST_KEY);
    if (secretInputEl) secretInputEl.value = RFC_TEST_KEY;
  }
</script>
