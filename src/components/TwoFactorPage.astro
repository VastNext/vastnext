---
import BrandMark from './BrandMark.astro';
import '../styles/two-factor.css';
import type { Locale } from '../content/site';
import { siteCopy } from '../content/site';
import { twoFactorCopy } from '../content/twoFactor';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = twoFactorCopy[locale];
const isZh = locale === 'zh';
const brandName = siteCopy[locale].brandName;
const homeHref = isZh ? '/zh/' : '/';
const langSwitchHref = isZh ? '/2fa/' : '/zh/2fa/';
const langSwitchLabel = isZh ? 'English' : '中文';
---

<div class="cw-app" data-locale={locale}>
  <!-- Top Masthead -->
  <header class="cw-masthead">
    <div class="cw-container cw-masthead__inner">
      <div class="cw-masthead__branding">
        <a href={homeHref} class="cw-masthead__brand-link" aria-label={isZh ? `返回${brandName}首页` : 'Back to VastNext Home'}>
          <BrandMark wordmarkText={brandName} />
        </a>
        <span class="cw-masthead__product-badge">
          Clockwork
        </span>
      </div>
      <div class="cw-masthead__spec">{copy.masthead.spec}</div>
      <div class="cw-masthead__nav">
        <div class="cw-masthead__state">
          <span class="cw-lamp"></span>
          <span>{copy.masthead.offline}</span>
        </div>
        <a href={langSwitchHref}>{langSwitchLabel}</a>
      </div>
    </div>
  </header>

  <main class="cw-container cw-main">
    <!-- Error Banner -->
    <div id="cw-error" class="cw-error-banner" role="alert"></div>

    <!-- VIEW MODE A: Direct 3-Minute Secret View (Only visible when URL has direct secret) -->
    <section id="cw-direct-view" class="cw-direct-card" style="display: none;">
      <div class="cw-direct-card__header">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span class="cw-direct-badge">{copy.directView.badge}</span>
          <span id="cw-direct-account-name" style="font-weight: 700; font-size: 1.05rem;"></span>
        </div>
        <div id="cw-session-pill" class="cw-session-pill cw-session-pill--active">
          <span class="cw-dot"></span>
          <span id="cw-session-status-text">{copy.directView.sessionTitle}</span>
        </div>
      </div>

      <!-- Click to Copy 2FA Code Box -->
      <div id="cw-direct-code-box" class="cw-code-box" title={copy.directView.clickToCopy}>
        <div id="cw-direct-code-digits" class="cw-code-digits">------</div>
        <div id="cw-direct-copy-badge" class="cw-copy-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="cw-direct-copy-text">{copy.directView.clickToCopy}</span>
        </div>
      </div>

      <!-- Dials & Timers Row -->
      <div class="cw-dial-row">
        <!-- 30s Circular Dial -->
        <div class="cw-gauge-block">
          <svg class="cw-gauge-svg" viewBox="0 0 44 44" id="cw-direct-dial-svg">
            <circle cx="22" cy="22" r="18" fill="none" stroke="rgba(24,35,92,0.1)" stroke-width="3.5"></circle>
            <circle id="cw-direct-dial-circle" cx="22" cy="22" r="18" fill="none" stroke="#F05A28" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="113.1" stroke-dashoffset="0" transform="rotate(-90 22 22)" style="transition: stroke-dashoffset 0.2s linear;"></circle>
          </svg>
          <div class="cw-gauge-info">
            <span id="cw-direct-period-sec" class="cw-gauge-sec">30s</span>
            <span class="cw-gauge-label">{copy.directView.periodRemaining}</span>
          </div>
        </div>

        <!-- 3-Minute Session Countdown -->
        <div class="cw-session-timer">
          <span style="font-size: 0.78rem; color: var(--cw-ink-3);">{copy.directView.sessionTimeRemaining}</span>
          <span id="cw-direct-session-time" class="cw-session-countdown">03:00</span>
        </div>
      </div>

      <!-- 3-Minute Expired Notice & Resume Button -->
      <div id="cw-direct-expired-banner" class="cw-expired-banner" style="display: none;">
        <div>
          <div class="cw-expired-title">{copy.directView.sessionExpiredTitle}</div>
          <p class="cw-expired-desc">{copy.directView.sessionExpiredDesc}</p>
        </div>
        <button id="cw-btn-resume-direct" type="button" class="cw-btn cw-btn--primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          {copy.directView.sessionExpiredAction}
        </button>
      </div>

      <!-- Quick Action to Switch to Full Workspace -->
      <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid var(--cw-rule); padding-top: 1.25rem;">
        <a id="cw-link-open-workspace" href={locale === 'zh' ? '/zh/2fa/' : '/2fa/'} style="font-size: 0.88rem; font-weight: 600; color: var(--cw-ink-2); text-decoration: none;">
          ← {copy.directView.openFullTool}
        </a>
      </div>
    </section>

    <!-- VIEW MODE B: Standard Clockwork Multi-Account Workspace -->
    <div id="cw-workspace-view">
      <!-- Zone 1: Codes Panel -->
      <section id="cw-zone-codes" class="cw-zone" style="margin-bottom: 1.5rem;">
        <div class="cw-zone-header">
          <div class="cw-zone-title">
            <span>{copy.workspace.codesTitle}</span>
            <span id="cw-account-chip" class="cw-chip" style="display: none;">0</span>
          </div>
        </div>

        <div class="cw-panel">
          <!-- Vacant State: Shown when input is empty -->
          <div id="cw-vacant-state" class="cw-vacant">
            <!-- Clockwork 30-mark Emblem Dial -->
            <svg class="cw-vacant-dial" viewBox="0 0 44 44" aria-hidden="true">
              <circle cx="22" cy="22" r="19" fill="none" stroke="rgba(24,35,92,0.12)" stroke-width="2"></circle>
              <line x1="22" y1="22" x2="22" y2="8" stroke="#F05A28" stroke-width="2" stroke-linecap="round"></line>
              <circle cx="22" cy="22" r="3" fill="#F05A28"></circle>
            </svg>
            <h2 class="cw-vacant-title">{copy.vacant.title}</h2>
            <p class="cw-vacant-desc">{copy.vacant.subtitle}</p>
          </div>

          <!-- Filter input when multiple accounts exist -->
          <div id="cw-filter-wrapper" class="cw-filter-box" style="display: none;">
            <input
              id="cw-filter-field"
              class="cw-filter-input"
              type="text"
              placeholder={copy.workspace.filterPlaceholder}
              aria-label={copy.workspace.filterPlaceholder}
            />
          </div>

          <!-- Strips Host: List of live TOTP channels -->
          <div id="cw-strips-host" class="cw-strips" style="display: none;"></div>
          <div id="cw-filter-empty" style="display: none; padding: 2rem; text-align: center; color: var(--cw-ink-3); font-size: 0.9rem;">
            {copy.workspace.filterEmpty}
          </div>
        </div>
      </section>

      <!-- Zone 2: Input Area -->
      <section class="cw-zone" style="margin-bottom: 1.5rem;">
        <div class="cw-zone-header">
          <div class="cw-zone-title">{copy.workspace.inputTitle}</div>
        </div>

        <div class="cw-panel">
          <p style="font-size: 0.88rem; color: var(--cw-ink-2); margin-bottom: 0.85rem;">
            {copy.workspace.inputSubtitle}
          </p>

          <textarea
            id="cw-input-textarea"
            class="cw-textarea"
            placeholder={copy.workspace.inputPlaceholder}
            rows="3"
          ></textarea>

          <div class="cw-actions">
            <button id="cw-btn-clear" type="button" class="cw-btn cw-btn--flat" style="display: none;">
              {copy.workspace.clearBtn}
            </button>
            <button id="cw-btn-demo" type="button" class="cw-btn cw-btn--default">
              {copy.workspace.insertTestKeyBtn}
            </button>
            <input id="cw-file-input" type="file" accept="image/*" style="display: none;" />
            <button id="cw-btn-qr" type="button" class="cw-btn cw-btn--default">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              {copy.workspace.qrFileBtn}
            </button>
          </div>

          <div class="cw-paste-hint">
            {copy.workspace.pasteQrHint}
          </div>

          <!-- LocalStorage Persistence Box -->
          <div class="cw-storage-box">
            <label class="cw-storage-label" for="cw-storage-toggle">
              <input type="checkbox" id="cw-storage-toggle" class="cw-checkbox" />
              <span>{copy.workspace.storageCheckboxLabel}</span>
            </label>
            <button type="button" id="cw-btn-clear-storage" class="cw-btn cw-btn--flat" style="font-size: 0.8rem; display: none;">
              {copy.workspace.storageClearBtn}
            </button>
          </div>

          <details class="cw-details">
            <summary>{copy.workspace.formatsSummary}</summary>
            <div style="padding-top: 0.6rem; line-height: 1.6;">
              <code>Name: SECRET</code> · <code>otpauth://totp/Issuer:user?secret=...</code> · <code># comment</code>
            </div>
          </details>
        </div>
      </section>

      <!-- Zone 3: Share Direct Link (Generated from first active key) -->
      <section id="cw-share-zone" class="cw-panel" style="display: none; margin-bottom: 2rem;">
        <h3 style="font-family: var(--font-display, 'Space Grotesk', sans-serif); font-size: 0.95rem; font-weight: 700; margin-bottom: 0.35rem;">
          {copy.workspace.shareLinkTitle}
        </h3>
        <p style="font-size: 0.85rem; color: var(--cw-ink-2); margin-bottom: 0.75rem;">
          {copy.workspace.shareLinkDesc}
        </p>
        <div style="display: flex; gap: 0.5rem; align-items: center;">
          <input id="cw-share-link-input" type="text" readonly style="flex: 1; padding: 0.6rem 0.85rem; background: var(--cw-ground); border: 1px solid var(--cw-rule); border-radius: 0.5rem; font-family: var(--cw-font-mono); font-size: 0.85rem; color: var(--cw-ink);" />
          <button id="cw-btn-copy-share-link" type="button" class="cw-btn cw-btn--primary" style="min-height: 2.2rem; font-size: 0.82rem;">
            {copy.workspace.shareLinkCopyBtn}
          </button>
        </div>
      </section>
    </div>

    <!-- Security & Trust Info -->
    <section>
      <h2 style="font-family: var(--font-display, 'Space Grotesk', sans-serif); font-size: 1.15rem; font-weight: 700; color: var(--cw-ink); margin-bottom: 0.85rem;">
        {copy.security.title}
      </h2>
      <div class="cw-trust-grid">
        {copy.security.items.map((item) => (
          <div class="cw-trust-item">
            <h3 class="cw-trust-title">{item.title}</h3>
            <p class="cw-trust-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- Toast Element -->
  <div id="cw-toast" class="cw-toast">{copy.directView.copied}</div>
</div>

<script>
  import { generateTotp, secondsUntilNextCode, periodProgress } from '../lib/twoFactor/totp';
  import { parseInputToAccount, formatOtpCode, type Account } from '../lib/twoFactor/otpauth';
  import { decodeQrFromBlob } from '../lib/twoFactor/qrDecode';

  const RFC_TEST_LINE = 'RFC 4226: GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ';
  const THREE_MINUTES_MS = 3 * 60 * 1000;
  const CIRCLE_CIRCUMFERENCE = 113.1; // 2 * PI * 18
  const STORAGE_KEY = 'vastnext_2fa_vault_secrets';
  const STORAGE_ENABLED_KEY = 'vastnext_2fa_vault_enabled';

  // State
  let accounts: Account[] = [];
  let directAccount: Account | null = null;
  let directStartTime = 0;
  let directExpired = false;

  const pageContainer = document.querySelector('.cw-app');
  const isZh = pageContainer?.getAttribute('data-locale') === 'zh';

  // DOM Elements
  const errorEl = document.getElementById('cw-error');
  const toastEl = document.getElementById('cw-toast');

  // Direct View Elements
  const directViewEl = document.getElementById('cw-direct-view');
  const workspaceViewEl = document.getElementById('cw-workspace-view');
  const directAccountNameEl = document.getElementById('cw-direct-account-name');
  const sessionPillEl = document.getElementById('cw-session-pill');
  const sessionStatusTextEl = document.getElementById('cw-session-status-text');
  const directCodeBoxEl = document.getElementById('cw-direct-code-box');
  const directCodeDigitsEl = document.getElementById('cw-direct-code-digits');
  const directCopyBadgeEl = document.getElementById('cw-direct-copy-badge');
  const directCopyTextEl = document.getElementById('cw-direct-copy-text');
  const directDialCircleEl = document.getElementById('cw-direct-dial-circle');
  const directPeriodSecEl = document.getElementById('cw-direct-period-sec');
  const directSessionTimeEl = document.getElementById('cw-direct-session-time');
  const directExpiredBannerEl = document.getElementById('cw-direct-expired-banner');
  const btnResumeDirectEl = document.getElementById('cw-btn-resume-direct');

  // Workspace Elements
  const vacantStateEl = document.getElementById('cw-vacant-state');
  const stripsHostEl = document.getElementById('cw-strips-host');
  const filterWrapperEl = document.getElementById('cw-filter-wrapper');
  const filterFieldEl = document.getElementById('cw-filter-field') as HTMLInputElement;
  const filterEmptyEl = document.getElementById('cw-filter-empty');
  const accountChipEl = document.getElementById('cw-account-chip');
  const inputTextareaEl = document.getElementById('cw-input-textarea') as HTMLTextAreaElement;
  const btnClearEl = document.getElementById('cw-btn-clear');
  const btnDemoEl = document.getElementById('cw-btn-demo');
  const btnQrEl = document.getElementById('cw-btn-qr');
  const fileInputEl = document.getElementById('cw-file-input') as HTMLInputElement;

  const storageToggleEl = document.getElementById('cw-storage-toggle') as HTMLInputElement;
  const btnClearStorageEl = document.getElementById('cw-btn-clear-storage') as HTMLButtonElement;

  const shareZoneEl = document.getElementById('cw-share-zone');
  const shareLinkInputEl = document.getElementById('cw-share-link-input') as HTMLInputElement;
  const btnCopyShareLinkEl = document.getElementById('cw-btn-copy-share-link');

  function showError(msg: string): void {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
  }

  function clearError(): void {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function showToast(text: string): void {
    if (!toastEl) return;
    toastEl.textContent = text;
    toastEl.classList.add('cw-toast--visible');
    setTimeout(() => {
      toastEl.classList.remove('cw-toast--visible');
    }, 2200);
  }

  function formatTime(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  // Sync with LocalStorage if enabled
  function syncLocalStorage(): void {
    if (!storageToggleEl) return;
    if (storageToggleEl.checked) {
      const val = inputTextareaEl?.value || '';
      try {
        localStorage.setItem(STORAGE_ENABLED_KEY, 'true');
        localStorage.setItem(STORAGE_KEY, val);
        if (btnClearStorageEl) btnClearStorageEl.style.display = val.trim() ? 'inline-flex' : 'none';
      } catch (e) {
        console.warn('LocalStorage error:', e);
      }
    } else {
      try {
        localStorage.removeItem(STORAGE_ENABLED_KEY);
        localStorage.removeItem(STORAGE_KEY);
        if (btnClearStorageEl) btnClearStorageEl.style.display = 'none';
      } catch (e) {
        console.warn('LocalStorage error:', e);
      }
    }
  }

  // Extract direct secret from URL path or query
  function extractDirectSecretFromUrl(): string | null {
    const searchParams = new URLSearchParams(window.location.search);
    const querySecret = searchParams.get('secret') || searchParams.get('key');
    if (querySecret) return querySecret.trim();

    if (window.location.hash) {
      const hash = window.location.hash.slice(1).trim();
      if (hash) return hash;
    }

    const pathname = window.location.pathname;
    // Matching /2fa/SECRET or /zh/2fa/SECRET
    const match = pathname.match(/(?:\/zh)?\/2fa\/([^/]+)/);
    if (match && match[1] && match[1] !== 'index.html') {
      try {
        return decodeURIComponent(match[1]).trim();
      } catch {
        return match[1].trim();
      }
    }

    return null;
  }

  // Parse multi-line input into accounts
  function parseWorkspaceInput(text: string): Account[] {
    const lines = text.split(/\r?\n/).map((l) => l.trim()).filter((l) => l !== '' && !l.startsWith('#'));
    const parsed: Account[] = [];
    for (const line of lines) {
      try {
        const account = parseInputToAccount(line);
        parsed.push(account);
      } catch (err) {
        console.warn('Could not parse line:', line, err);
      }
    }
    return parsed;
  }

  // Append secret or otpauth URI to textarea
  function appendSecretToInput(newSecret: string): void {
    if (!inputTextareaEl) return;
    const existing = inputTextareaEl.value.trim();
    if (!existing) {
      inputTextareaEl.value = newSecret;
    } else {
      inputTextareaEl.value = `${existing}\n${newSecret}`;
    }
    accounts = parseWorkspaceInput(inputTextareaEl.value);
    renderWorkspaceStrips();
    updateClock();
    syncLocalStorage();
    clearError();
  }

  // Handle QR image file (from clipboard Ctrl+V, drag & drop, or file picker)
  async function handleImageFile(file: Blob): Promise<void> {
    showToast(isZh ? '正在识别图片二维码...' : 'Decoding QR code from image...');
    try {
      const decodedText = await decodeQrFromBlob(file);
      if (decodedText) {
        appendSecretToInput(decodedText);
        showToast(isZh ? '成功识别二维码并已自动录入！' : 'QR code decoded and added!');
      } else {
        showError(isZh ? '未在图片中检测到有效的二维码。' : 'No valid QR code detected in image.');
      }
    } catch (err) {
      showError(isZh ? '二维码解析发生错误，请确认图片清晰度。' : 'Failed to decode QR code from image.');
    }
  }

  // ── Render Direct 3-Minute View ──
  function setupDirectView(secret: string): void {
    try {
      directAccount = parseInputToAccount(secret);
      directStartTime = Date.now();
      directExpired = false;

      if (directViewEl) directViewEl.style.display = 'block';
      if (workspaceViewEl) workspaceViewEl.style.display = 'none';

      if (directAccountNameEl) {
        directAccountNameEl.textContent = directAccount.issuer || (isZh ? '2FA 验证码' : '2FA Code');
      }

      if (sessionPillEl) sessionPillEl.className = 'cw-session-pill cw-session-pill--active';
      if (sessionStatusTextEl) sessionStatusTextEl.textContent = isZh ? '实时刷新中' : 'Auto-refresh Active';
      if (directCodeBoxEl) directCodeBoxEl.classList.remove('cw-code-box--expired');
      if (directExpiredBannerEl) directExpiredBannerEl.style.display = 'none';

      clearError();
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Invalid Secret');
      if (directViewEl) directViewEl.style.display = 'none';
      if (workspaceViewEl) workspaceViewEl.style.display = 'block';
    }
  }

  // ── Render Workspace Strips ──
  function renderWorkspaceStrips(): void {
    if (!stripsHostEl || !vacantStateEl) return;

    if (accounts.length === 0) {
      vacantStateEl.style.display = 'flex';
      stripsHostEl.style.display = 'none';
      if (filterWrapperEl) filterWrapperEl.style.display = 'none';
      if (accountChipEl) accountChipEl.style.display = 'none';
      if (shareZoneEl) shareZoneEl.style.display = 'none';
      if (btnClearEl) btnClearEl.style.display = 'none';
      return;
    }

    vacantStateEl.style.display = 'none';
    stripsHostEl.style.display = 'flex';
    if (btnClearEl) btnClearEl.style.display = 'inline-flex';

    if (accountChipEl) {
      accountChipEl.textContent = isZh ? `${accounts.length} 个账户` : `${accounts.length} accounts`;
      accountChipEl.style.display = 'inline-block';
    }

    if (filterWrapperEl) {
      filterWrapperEl.style.display = accounts.length >= 3 ? 'block' : 'none';
    }

    // Update share link box with first account
    if (shareZoneEl && shareLinkInputEl && accounts[0]) {
      const origin = window.location.origin;
      const prefix = isZh ? '/zh/2fa/' : '/2fa/';
      shareLinkInputEl.value = `${origin}${prefix}${accounts[0].rawSecret}`;
      shareZoneEl.style.display = 'block';
    }

    // Build strip DOM elements
    const filterQuery = filterFieldEl?.value?.toLowerCase().trim() || '';
    stripsHostEl.innerHTML = '';
    let visibleMatches = 0;

    accounts.forEach((acc, index) => {
      const label = acc.issuer || (acc.accountName ? `${acc.accountName}` : `Account #${index + 1}`);
      const matches = !filterQuery || label.toLowerCase().includes(filterQuery) || acc.rawSecret.toLowerCase().includes(filterQuery);

      if (!matches) return;
      visibleMatches++;

      const stripEl = document.createElement('div');
      stripEl.className = 'cw-strip';
      stripEl.dataset['index'] = String(index);

      const prefix = isZh ? '/zh/2fa/' : '/2fa/';
      const directHref = `${prefix}${acc.rawSecret}`;

      stripEl.innerHTML = `
        <svg class="cw-strip__gauge" viewBox="0 0 44 44" data-gauge="${index}">
          <circle cx="22" cy="22" r="18" fill="none" stroke="rgba(24,35,92,0.1)" stroke-width="3"></circle>
          <line class="cw-hand" x1="22" y1="22" x2="22" y2="7" stroke="#F05A28" stroke-width="2.5" stroke-linecap="round" transform-origin="22 22"></line>
          <circle cx="22" cy="22" r="2.5" fill="#F05A28"></circle>
        </svg>
        <div class="cw-strip__main">
          <div class="cw-strip__header">
            <span class="cw-strip__name">${label}</span>
            <span class="cw-strip__param">${acc.algorithm} · ${acc.digits}d · ${acc.period}s</span>
          </div>
          <div class="cw-strip__code" data-code-index="${index}" title="${isZh ? '点击复制验证码' : 'Click to copy'}">------</div>
          <div class="cw-strip__meta">
            <span class="cw-next-preview" data-next-index="${index}"></span>
            <a href="${directHref}" class="cw-strip__direct-link" title="${isZh ? '打开 3 分钟独立直达视图' : 'Open 3-minute direct view'}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              <span>${isZh ? '3分钟直达链接' : '3-min link'}</span>
            </a>
          </div>
        </div>
        <div class="cw-strip__actions">
          <button type="button" class="cw-btn-copy" data-copy-index="${index}">
            ${isZh ? '复制' : 'Copy'}
          </button>
        </div>
      `;

      // Event listener for click-to-copy code
      const codeEl = stripEl.querySelector('.cw-strip__code');
      codeEl?.addEventListener('click', () => copyStripCode(index, stripEl));

      const copyBtn = stripEl.querySelector('.cw-btn-copy');
      copyBtn?.addEventListener('click', () => copyStripCode(index, stripEl));

      stripsHostEl.appendChild(stripEl);
    });

    if (filterEmptyEl) {
      filterEmptyEl.style.display = visibleMatches === 0 && accounts.length > 0 ? 'block' : 'none';
    }
  }

  // Copy code helper for strip
  async function copyStripCode(index: number, stripEl: HTMLElement): Promise<void> {
    const acc = accounts[index];
    if (!acc) return;
    const nowSec = Date.now() / 1000;
    try {
      const code = await generateTotp({
        secret: acc.secret,
        unixSeconds: nowSec,
        algorithm: acc.algorithm,
        digits: acc.digits,
        period: acc.period,
      });
      await navigator.clipboard.writeText(code);
      showToast(isZh ? `已复制验证码: ${code}` : `Copied code: ${code}`);

      const btn = stripEl.querySelector<HTMLButtonElement>('.cw-btn-copy');
      if (btn) {
        btn.textContent = isZh ? '已复制' : 'Copied';
        btn.classList.add('cw-btn-copy--done');
        setTimeout(() => {
          btn.textContent = isZh ? '复制' : 'Copy';
          btn.classList.remove('cw-btn-copy--done');
        }, 1800);
      }
    } catch {
      showToast(isZh ? '复制失败' : 'Copy failed');
    }
  }

  // ── Global Clock Tick ──
  async function updateClock(): Promise<void> {
    const nowMs = Date.now();
    const nowSec = nowMs / 1000;

    // 1. Update Direct 3-Minute View if active
    if (directAccount) {
      const elapsed = nowMs - directStartTime;
      const remainingMs = Math.max(0, THREE_MINUTES_MS - elapsed);
      const remainingSec = Math.ceil(remainingMs / 1000);

      if (directSessionTimeEl) {
        directSessionTimeEl.textContent = formatTime(remainingSec);
      }

      if (remainingMs <= 0 && !directExpired) {
        directExpired = true;
        if (sessionPillEl) sessionPillEl.className = 'cw-session-pill cw-session-pill--expired';
        if (sessionStatusTextEl) sessionStatusTextEl.textContent = isZh ? '已停止自动刷新（3分钟上限）' : 'Auto-refresh stopped';
        if (directCodeBoxEl) directCodeBoxEl.classList.add('cw-code-box--expired');
        if (directExpiredBannerEl) directExpiredBannerEl.style.display = 'flex';
      }

      if (!directExpired) {
        const period = directAccount.period;
        const secondsLeft = secondsUntilNextCode(nowSec, period);
        const progress = periodProgress(nowSec, period);

        if (directPeriodSecEl) directPeriodSecEl.textContent = `${secondsLeft}s`;
        if (directDialCircleEl) {
          const offset = CIRCLE_CIRCUMFERENCE * (1 - progress);
          directDialCircleEl.style.strokeDashoffset = String(offset);
        }

        try {
          const code = await generateTotp({
            secret: directAccount.secret,
            unixSeconds: nowSec,
            algorithm: directAccount.algorithm,
            digits: directAccount.digits,
            period: directAccount.period,
          });
          if (directCodeDigitsEl) directCodeDigitsEl.textContent = formatOtpCode(code);
        } catch (e) {
          console.error('TOTP calculation error:', e);
        }
      }
    }

    // 2. Update Workspace Strips if active
    if (accounts.length > 0) {
      for (let i = 0; i < accounts.length; i++) {
        const acc = accounts[i];
        if (!acc) continue;
        const period = acc.period;
        const secondsLeft = secondsUntilNextCode(nowSec, period);
        const progress = periodProgress(nowSec, period);

        // Update Dial Hand
        const hand = document.querySelector<SVGLineElement>(`svg[data-gauge="${i}"] .cw-hand`);
        if (hand) {
          const angle = progress * 360;
          hand.setAttribute('transform', `rotate(${angle} 22 22)`);
        }

        // Update Active Code
        const codeEl = document.querySelector<HTMLElement>(`.cw-strip__code[data-code-index="${i}"]`);
        if (codeEl) {
          try {
            const code = await generateTotp({
              secret: acc.secret,
              unixSeconds: nowSec,
              algorithm: acc.algorithm,
              digits: acc.digits,
              period: acc.period,
            });
            codeEl.textContent = formatOtpCode(code);
          } catch (e) {
            codeEl.textContent = 'ERROR';
          }
        }

        // Update Next Preview
        const nextEl = document.querySelector<HTMLElement>(`.cw-next-preview[data-next-index="${i}"]`);
        if (nextEl) {
          try {
            const nextCode = await generateTotp({
              secret: acc.secret,
              unixSeconds: nowSec + period,
              algorithm: acc.algorithm,
              digits: acc.digits,
              period: acc.period,
            });
            nextEl.textContent = `${isZh ? '下一轮' : 'next'} ${formatOtpCode(nextCode)} · ${secondsLeft}s`;
          } catch {
            nextEl.textContent = `${secondsLeft}s`;
          }
        }
      }
    }
  }

  // ── Event Handlers ──
  directCodeBoxEl?.addEventListener('click', async (e) => {
    if (e.target instanceof Element && e.target.closest('#cw-btn-resume-direct')) return;
    if (!directAccount) return;
    const nowSec = Date.now() / 1000;
    try {
      const code = await generateTotp({
        secret: directAccount.secret,
        unixSeconds: nowSec,
        algorithm: directAccount.algorithm,
        digits: directAccount.digits,
        period: directAccount.period,
      });
      await navigator.clipboard.writeText(code);
      showToast(isZh ? `已复制验证码: ${code}` : `Copied code: ${code}`);
      if (directCopyBadgeEl && directCopyTextEl) {
        directCopyBadgeEl.classList.add('cw-copy-badge--copied');
        directCopyTextEl.textContent = isZh ? '已复制！' : 'Copied!';
        setTimeout(() => {
          directCopyBadgeEl.classList.remove('cw-copy-badge--copied');
          directCopyTextEl.textContent = isZh ? '点击验证码一键复制' : 'Click code to copy';
        }, 1800);
      }
    } catch {
      showToast(isZh ? '复制失败' : 'Copy failed');
    }
  });

  btnResumeDirectEl?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (directAccount) {
      directStartTime = Date.now();
      directExpired = false;
      if (sessionPillEl) sessionPillEl.className = 'cw-session-pill cw-session-pill--active';
      if (sessionStatusTextEl) sessionStatusTextEl.textContent = isZh ? '实时刷新中' : 'Auto-refresh Active';
      if (directCodeBoxEl) directCodeBoxEl.classList.remove('cw-code-box--expired');
      if (directExpiredBannerEl) directExpiredBannerEl.style.display = 'none';
      showToast(isZh ? '已重新开始 3 分钟自动刷新' : '3-Minute auto-refresh resumed');
      updateClock();
    }
  });

  inputTextareaEl?.addEventListener('input', () => {
    const val = inputTextareaEl.value;
    accounts = parseWorkspaceInput(val);
    renderWorkspaceStrips();
    updateClock();
    syncLocalStorage();
  });

  storageToggleEl?.addEventListener('change', () => {
    syncLocalStorage();
    if (storageToggleEl.checked) {
      showToast(isZh ? '已启用本地存储，Token 将保存在本浏览器' : 'LocalStorage enabled');
    } else {
      showToast(isZh ? '已关闭本地存储' : 'LocalStorage disabled');
    }
  });

  btnClearStorageEl?.addEventListener('click', () => {
    try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(STORAGE_ENABLED_KEY);
      if (storageToggleEl) storageToggleEl.checked = false;
      if (btnClearStorageEl) btnClearStorageEl.style.display = 'none';
      showToast(isZh ? '已清空本地存储中的 Token' : 'Tokens cleared from LocalStorage');
    } catch (e) {
      console.warn('Clear storage error:', e);
    }
  });

  filterFieldEl?.addEventListener('input', () => {
    renderWorkspaceStrips();
  });

  btnClearEl?.addEventListener('click', () => {
    if (inputTextareaEl) inputTextareaEl.value = '';
    accounts = [];
    renderWorkspaceStrips();
    clearError();
    syncLocalStorage();
  });

  btnDemoEl?.addEventListener('click', () => {
    if (inputTextareaEl) {
      inputTextareaEl.value = RFC_TEST_LINE;
    }
    accounts = parseWorkspaceInput(RFC_TEST_LINE);
    renderWorkspaceStrips();
    updateClock();
    syncLocalStorage();
    showToast(isZh ? '已填入官方 RFC 测试密钥' : 'RFC test key inserted');
  });

  btnQrEl?.addEventListener('click', () => {
    fileInputEl?.click();
  });

  fileInputEl?.addEventListener('change', async () => {
    const file = fileInputEl?.files?.[0];
    if (!file) return;
    await handleImageFile(file);
    fileInputEl.value = '';
  });

  // ── Clipboard (Ctrl+V) Image & Drag-Drop Handling ──
  document.addEventListener('paste', async (event: ClipboardEvent) => {
    const items = event.clipboardData?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
      const item = items[i];
      if (item && item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) {
          event.preventDefault();
          await handleImageFile(file);
          return;
        }
      }
    }
  });

  document.addEventListener('dragover', (event: DragEvent) => {
    if (event.dataTransfer?.types.includes('Files')) {
      event.preventDefault();
      document.body.classList.add('cw-dropping');
    }
  });

  document.addEventListener('dragleave', (event: DragEvent) => {
    if (event.relatedTarget === null) {
      document.body.classList.remove('cw-dropping');
    }
  });

  document.addEventListener('drop', async (event: DragEvent) => {
    document.body.classList.remove('cw-dropping');
    const file = [...(event.dataTransfer?.files ?? [])].find((f) => f.type.startsWith('image/'));
    if (file) {
      event.preventDefault();
      await handleImageFile(file);
    }
  });

  btnCopyShareLinkEl?.addEventListener('click', async () => {
    if (!shareLinkInputEl) return;
    try {
      await navigator.clipboard.writeText(shareLinkInputEl.value);
      showToast(isZh ? '3分钟直达链接已复制！' : '3-Minute link copied!');
    } catch {
      showToast(isZh ? '复制失败' : 'Copy failed');
    }
  });

  // ── Initialization ──
  const initialDirectSecret = extractDirectSecretFromUrl();

  if (initialDirectSecret) {
    // Direct Secret URL Mode (e.g. /2fa/JDU5RLZDW7LENCLQ7PCB3QJEUA4HOAZ6)
    setupDirectView(initialDirectSecret);
  } else {
    // Standard Clockwork Workspace Mode (/2fa/ or /zh/2fa/)
    if (directViewEl) directViewEl.style.display = 'none';
    if (workspaceViewEl) workspaceViewEl.style.display = 'block';

    // Check if user has saved tokens in localStorage
    try {
      const storageEnabled = localStorage.getItem(STORAGE_ENABLED_KEY) === 'true';
      const savedSecrets = localStorage.getItem(STORAGE_KEY);
      if (storageEnabled && savedSecrets && savedSecrets.trim()) {
        if (storageToggleEl) storageToggleEl.checked = true;
        if (btnClearStorageEl) btnClearStorageEl.style.display = 'inline-flex';
        if (inputTextareaEl) inputTextareaEl.value = savedSecrets;
        accounts = parseWorkspaceInput(savedSecrets);
      } else {
        if (storageToggleEl) storageToggleEl.checked = false;
        if (inputTextareaEl) inputTextareaEl.value = '';
        accounts = [];
      }
    } catch (e) {
      if (inputTextareaEl) inputTextareaEl.value = '';
      accounts = [];
    }

    renderWorkspaceStrips();
  }

  // Start continuous clock loop (every 500ms)
  updateClock();
  window.setInterval(updateClock, 500);
</script>
