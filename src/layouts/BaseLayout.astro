---
import type { Locale } from '../content/site';
import { siteCopy, siteFacts } from '../content/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath?: string;
}

const { locale, title, description, canonicalPath, alternatePath } = Astro.props;
const normalizedPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const inferredAlternatePath = locale === 'en'
  ? normalizedPath === '/' ? '/zh/' : `/zh${normalizedPath}`
  : normalizedPath === '/zh/' ? '/' : normalizedPath.replace(/^\/zh(?=\/)/, '');
const normalizedAlternatePath = alternatePath
  ? alternatePath.startsWith('/') ? alternatePath : `/${alternatePath}`
  : inferredAlternatePath;
const enPath = locale === 'en' ? normalizedPath : normalizedAlternatePath;
const zhPath = locale === 'zh' ? normalizedPath : normalizedAlternatePath;
const canonicalUrl = new URL(normalizedPath, siteFacts.siteUrl);
const enUrl = new URL(enPath, siteFacts.siteUrl);
const zhUrl = new URL(zhPath, siteFacts.siteUrl);
const ogImageUrl = new URL(siteFacts.ogImage, siteFacts.siteUrl);
const metadata = siteCopy[locale].metadata;
const ogImageAlt = `${siteFacts.brandName}: ${siteCopy[locale].tagline}`;
const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteFacts.brandName,
  url: siteFacts.siteUrl,
  logo: new URL('/favicon.svg', siteFacts.siteUrl).href,
  sameAs: ['https://github.com/VastNext'],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F8F3" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteFacts.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(siteFacts.ogImageWidth)} />
    <meta property="og:image:height" content={String(siteFacts.ogImageHeight)} />
    <meta property="og:image:type" content={siteFacts.ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={metadata.ogLocale} />
    <meta property="og:locale:alternate" content={metadata.alternateLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={organizationJsonLd} is:inline />
  </head>
  <body>
    <slot />
  </body>
</html>
